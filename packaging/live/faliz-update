#!/bin/sh
set -eu

case "${1:-}" in
  --check)
    echo "FALIZ Update Manager: checking available updates"
    apt-get -s -o APT::Get::Assume-Yes=false upgrade
    ;;
  --apply)
    [ "${2:-}" = "--confirm" ] || {
      echo "Refusing update: run faliz-update --apply --confirm." >&2
      exit 2
    }
    exec apt-get update && apt-get upgrade
    ;;
  *)
    cat <<'EOF'
FALIZ Update Manager foundation

  faliz-update --check
  faliz-update --apply --confirm

The check mode is read-only. Apply mode requires explicit confirmation.
EOF
    ;;
esac
